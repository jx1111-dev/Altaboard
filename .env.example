# PostgreSQL connection (shared by web + worker containers; host is the compose service name)
# For local dev outside Docker use: postgresql://altaboard:altaboard@localhost:5432/altaboard
DATABASE_URL=postgresql://altaboard:altaboard@db:5432/altaboard

# Postgres login for the compose db service + containers' DATABASE_URL (default: altaboard).
POSTGRES_USER=
# Password for that login; same consumers, compose default (altaboard).
POSTGRES_PASSWORD=
# Database created on first db boot; also the DATABASE_URL path segment (default: altaboard).
POSTGRES_DB=

# Blizzard API credentials — create a client at https://develop.battle.net
# No redirect URI needed (machine-to-machine client credentials only).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Default region when adding characters (us | eu | kr | tw)
DEFAULT_REGION=eu

# Set to 1 to run without Blizzard API access (mock data, UI testing only)
MOCK_BLIZZARD=

# Password for the optional Redis service (docker compose --profile redis);
# leave unset to use the compose default (altaboard-redis).
REDIS_PASSWORD=
