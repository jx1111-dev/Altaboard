// Altaboard data model. Known limitations (by design, see README):
// rename/realm transfer creates a new character row, history is not migrated.
// Game versions and reset schedules live as code constants (GAME_VERSIONS in
// lib/board, DEFAULT_SCHEDULES in lib/week) - the DB once had write-only
// GameVersion/ResetSchedule tables for them, dropped as dead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Character {
  id             String    @id @default(cuid())
  gameVersion    String
  region         String
  realmSlug      String
  nameLower      String
  name           String
  characterClass String?
  spec           String?
  level          Int?
  guildName      String?
  priority       Int       @default(100)
  groupName      String?
  archived       Boolean   @default(false)
  lastFetchedAt  DateTime?
  lastFetchError String?
  // Transient-failure backoff, advanced by refreshCharacter (exponential,
  // see board/index.ts); the daily sweep skips characters not yet due.
  fetchFailures  Int       @default(0)
  nextAttemptAt  DateTime?

  snapshots    CharacterSnapshot[]
  completions  TaskCompletion[]

  @@unique([gameVersion, region, realmSlug, nameLower])
  @@index([archived, priority])
}

model CharacterSnapshot {
  id          String   @id @default(cuid())
  characterId String
  weekId      String // e.g. '2026-09-23', the reset week this snapshot belongs to
  capturedAt  DateTime @default(now())
  payload     Json // merged raw profile/equipment data
  ilvl        Float?
  mplusRating Int?
  achievementPoints Int?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, weekId])
  @@index([characterId, capturedAt])
}

model TaskCatalog {
  id         String  @id @default(cuid())
  gameVersion String
  taskKey    String
  label      String
  category   String // raid | mplus | pvp | world | profession | attunement | other
  scope      String // 'weekly' | 'one_time'
  source     String // 'auto:<derivationKey>' | 'manual'
  sortOrder  Int     @default(100)
  active     Boolean @default(true)

  @@unique([gameVersion, taskKey])
}

// taskKey is a plain string, not a relation: the toggle route validates it
// against TaskCatalog at write time, and completion rows must survive catalog
// edits (deactivate/rekey) without FK drama. Prisma cannot model the one_time
// partial unique index (weekId IS NULL); it is hand-written in SQL and
// re-asserted by every migration that touches this table.
model TaskCompletion {
  id          String   @id @default(cuid())
  characterId String
  taskKey     String
  weekId      String? // null = one_time task
  done        Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, taskKey, weekId])
  @@index([characterId, weekId])
}

model ApiCache {
  key       String   @id
  payload   Json
  expiresAt DateTime

  @@index([expiresAt])
}

model JobRun {
  id         String    @id @default(cuid())
  type       String // 'rollover_sweep' | 'daily_sweep'
  status     String // 'running' | 'success' | 'partial'
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  detail     Json?
}
